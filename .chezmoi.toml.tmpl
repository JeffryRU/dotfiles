# Plantilla del fichero de configuración de chezmoi.
# Se materializa en ~/.config/chezmoi/chezmoi.toml al ejecutar `chezmoi init`.

# Fija el repo como directorio fuente permanente, viva donde viva en cada
# máquina (aquí: ~/Documents/GitHub/dotfiles).
sourceDir = {{ .chezmoi.sourceDir | replace "\\" "/" | quote }}

[edit]
    command = "code"
    args = ["--wait"]

[diff]
    exclude = ["scripts"]

[git]
    autoCommit = false
    autoPush = false

{{- if eq .chezmoi.os "windows" }}

# Ejecuta los scripts .ps1 del repo con PowerShell 7, no con el 5.1 del sistema.
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{- end }}
